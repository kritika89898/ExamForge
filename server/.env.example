# Free key from https://aistudio.google.com/apikey. On Vercel, add it under
# Project Settings > Environment Variables. Never commit the real key.
GEMINI_API_KEY=your_gemini_api_key
# Optional: comma-separated models to try in order.
# Default: gemini-3.5-flash-lite,gemini-3.8-flash
# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.8-flash
PORT=5000
# Optional comma-separated origins, for example: http://localhost:3000,https://example.com
CORS_ORIGIN=http://localhost:5000
