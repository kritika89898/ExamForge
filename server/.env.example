GEMINI_API_KEY=your_gemini_api_key
PORT=5000
# Optional comma-separated origins, for example: http://localhost:3000,https://example.com
CORS_ORIGIN=http://localhost:5000

# Supabase Storage. The project URL and bucket name are public configuration.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_STORAGE_BUCKET=academic-files

# Server only. Create an sb_secret_... key in Settings > API Keys.
# Configure this as a private Render environment variable. Never place it in client files or GitHub.
SUPABASE_SECRET_KEY=sb_secret_your_private_key

# Use "local" only for development/testing. Production defaults to the private Supabase review queue.
EXAMFORGE_STORAGE_MODE=local
